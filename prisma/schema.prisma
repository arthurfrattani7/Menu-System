datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  coupleAsUserOne Couple? @relation("CoupleUserOne")
  coupleAsUserTwo Couple? @relation("CoupleUserTwo")
}

model Couple {
  id        String   @id @default(uuid())
  userOne   User     @relation("CoupleUserOne", fields: [userOneId], references: [id])
  userOneId String   @unique
  userTwo   User     @relation("CoupleUserTwo", fields: [userTwoId], references: [id])
  userTwoId String   @unique
  createdAt DateTime @default(now())

  pages Page[]
}

model Page {
  id        String   @id @default(uuid())
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  coupleId  String
  order     Int
  music     Music?   @relation(fields: [musicId], references: [id])
  musicId   String?
  photos    Photo[]
  createdAt DateTime @default(now())
}

model Music {
  id     String @id @default(uuid())
  name   String
  artist String
  url    String
  pages  Page[]
}

model Photo {
  id        String   @id @default(uuid())
  url       String
  sortOrder Int      @default(0)
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  createdAt DateTime @default(now())
}
