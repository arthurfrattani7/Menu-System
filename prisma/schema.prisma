datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model Artist {
  id     String  @id @default(uuid())
  name   String
  albums Album[]
}

model Album {
  id       String  @id @default(uuid())
  name     String
  artist   Artist? @relation(fields: [artistId], references: [id])
  artistId String?

  music Music[]
}

model Music {
  id       String       @id @default(uuid())
  name     String
  album    Album?       @relation(fields: [albumId], references: [id])
  albumId  String?
  audios   MusicAudio[]
  images   MusicImage[]
}

model MusicAudio {
  id        String   @id @default(uuid())
  name      String
  url       String
  duration  Int?
  music     Music    @relation(fields: [musicId], references: [id], onDelete: Cascade)
  musicId   String
  createdAt DateTime @default(now())
}

model MusicImage {
  id        String   @id @default(uuid())
  name      String?
  url       String
  music     Music    @relation(fields: [musicId], references: [id], onDelete: Cascade)
  musicId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
